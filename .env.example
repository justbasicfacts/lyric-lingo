# Copy to .env and fill in.

# Translations (optional, lyrics still show without it)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

PORT=8899
DEFAULT_TARGET_LANG=English

# Local player read over MPRIS. Comma separated, first match wins.
MPRIS_PLAYERS=spotify

# Optional fallback for music playing on another device.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8899/callback
